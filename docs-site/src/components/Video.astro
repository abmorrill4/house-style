---
// Click-to-load YouTube player. Nothing is requested from Google until the reader selects Play:
// the poster is served from this site, and the iframe (youtube-nocookie) is added on click.
// Ids live in src/data/videos.json, so a re-upload changes one line. An entry with no id renders nothing.
import videos from '../data/videos.json';

interface Props { slug: keyof typeof videos }
const { slug } = Astro.props;
const v = videos[slug];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{v?.youtube && (
  <figure class="hs-video not-content">
    <button type="button" class="hs-video-play" data-id={v.youtube} data-title={v.title} aria-label={`Play video: ${v.title}`}>
      <img src={`${base}/videos/${slug}.jpg`} alt="" width="1280" height="720" loading="lazy" />
      <svg viewBox="0 0 68 48" aria-hidden="true"><rect width="68" height="48" rx="12" /><path d="M27 15v18l16-9z" /></svg>
    </button>
    <figcaption>
      Narrated with a synthetic voice. Recorded with {v.recorded}.{' '}
      <a href={`https://www.youtube.com/watch?v=${v.youtube}`}>Watch on YouTube</a>
    </figcaption>
    <details>
      <summary>Transcript</summary>
      <p>{v.transcript}</p>
    </details>
  </figure>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('.hs-video-play').forEach((b) =>
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(b.dataset.id!)}?autoplay=1&rel=0`;
      f.title = b.dataset.title!;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      b.replaceWith(f);
      f.focus();
    }),
  );
</script>

<style>
  .hs-video { margin: 1.5rem 0; }
  .hs-video-play, .hs-video :global(iframe) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0; border-radius: 0.5rem; overflow: hidden; }
  .hs-video-play { position: relative; cursor: pointer; background: var(--sl-color-black); }
  .hs-video-play img { width: 100%; height: 100%; object-fit: cover; }
  .hs-video-play svg { position: absolute; inset: 0; margin: auto; width: 68px; height: 48px; }
  .hs-video-play rect { fill: var(--sl-color-accent); opacity: 0.9; }
  .hs-video-play path { fill: #fff; }
  .hs-video-play:hover rect, .hs-video-play:focus-visible rect { opacity: 1; }
  .hs-video-play:focus-visible { outline: 3px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .hs-video figcaption { margin-top: 0.5rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .hs-video details { margin-top: 0.5rem; font-size: var(--sl-text-sm); }
</style>
