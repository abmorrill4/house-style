---
// A tutorial video that loads nothing from YouTube until the reader selects play. Before the click the page shows a local
// poster in a <button>. The click swaps in a youtube-nocookie.com player with captions on. Video ids live only in
// src/data/videos.json, so a page names a video by its slug: <Video slug="lint-topic-1" />.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import videos from '../data/videos.json';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const video = videos.find((v) => v.slug === slug);
if (!video) throw new Error(`Video.astro: no video with slug "${slug}" in src/data/videos.json`);

const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/videos/*.{webp,jpg,png}', { eager: true });
const poster = posters[`../assets/videos/${video.poster}`]?.default;
if (!poster) throw new Error(`Video.astro: poster ${video.poster} for "${slug}" is not in src/assets/videos`);

const [min, sec] = video.duration.split(':');
const isoDuration = `PT${Number(min)}M${Number(sec)}S`;
const watchUrl = `https://www.youtube.com/watch?v=${video.youtubeId}`;
const titleId = `video-${slug}-title`;
---

<figure class="hs-video not-content" aria-labelledby={titleId}>
  <div class="hs-video-frame">
    <button type="button" class="hs-video-play" data-video-id={video.youtubeId} data-video-title={video.title} aria-label={`Play the video ${video.title}`}>
      <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 50rem) 45rem, 100vw" loading="lazy" decoding="async" />
      <span class="hs-video-icon" aria-hidden="true">
        <svg viewBox="0 0 68 48" width="68" height="48" focusable="false"><rect width="68" height="48" rx="12" /><path d="M27 14v20l18-10z" /></svg>
      </span>
    </button>
  </div>
  <figcaption>
    <span class="hs-video-title" id={titleId}>{video.title}</span>
    <span class="hs-video-duration"><time datetime={isoDuration}>{video.duration}</time></span>
    <span class="hs-video-summary">{video.summary}</span>
  </figcaption>
  <p class="hs-video-notes">
    Narrated with a synthetic voice. Recorded with House Style {video.version} and Flare {video.flare}.
  </p>
  <p class="hs-video-notes">
    The narration describes everything on screen, so the video has no separate audio description. Menu names are shown in English.
  </p>
  <details class="hs-video-transcript">
    <summary>Transcript</summary>
    {video.transcript.map((para) => <p>{para}</p>)}
  </details>
  <p class="hs-video-notes"><a href={watchUrl}>Watch on YouTube</a></p>
</figure>

<script>
  // Swaps the poster button for the YouTube player. Nothing loads from YouTube before this click.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('.hs-video-play');
    if (!button) return;
    const id = button.dataset.videoId ?? '';
    if (!/^[\w-]{11}$/.test(id)) return;
    const frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&cc_load_policy=1&rel=0`;
    frame.title = button.dataset.videoTitle ?? 'Video';
    frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    frame.allowFullscreen = true;
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    button.replaceWith(frame);
    frame.focus();
  });
</script>

<style>
  .hs-video {
    margin: 1.5rem 0 2rem;
  }
  .hs-video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--sl-color-gray-6);
  }
  .hs-video-play,
  .hs-video-frame :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .hs-video-play {
    position: relative;
    padding: 0;
    margin: 0;
    background: none;
    cursor: pointer;
  }
  .hs-video-play img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hs-video-play:focus-visible {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: -3px;
  }
  .hs-video-icon {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    line-height: 0;
  }
  .hs-video-icon rect {
    fill: rgb(16 25 30 / 0.85);
    transition: fill 0.15s;
  }
  .hs-video-icon path {
    fill: #fff;
  }
  .hs-video-play:hover .hs-video-icon rect,
  .hs-video-play:focus-visible .hs-video-icon rect {
    fill: #0d7480;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
  }
  .hs-video-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .hs-video-summary {
    flex-basis: 100%;
  }
  .hs-video-notes {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .hs-video-notes a {
    color: var(--sl-color-text-accent);
  }
  .hs-video-transcript {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .hs-video-transcript summary {
    cursor: pointer;
    color: var(--sl-color-text-accent);
  }
  .hs-video-transcript summary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .hs-video-transcript p {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
  }
</style>
