{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "house-style-feedback",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	// No nodejs_compat: the Worker uses only web-standard APIs (fetch, crypto.subtle, streams).
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		// Private repo that receives the issues. The token (secret GITHUB_TOKEN) must be limited to this repo.
		"GITHUB_REPO": "abmorrill4/house-style-reports",
		// Kill switch: "1" makes /v1/report and /v1/false-positive answer 503 until set back to "0".
		"FEEDBACK_DISABLED": "0"
	},
	"secrets": {
		"required": ["GITHUB_TOKEN"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "house-style-feedback",
			// Replace with the id printed by `npx wrangler d1 create house-style-feedback`.
			"database_id": "da17aec2-c86e-4f91-b5ec-af1635e3f96e",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Weekly false-positive summary: Mondays 08:00 UTC.
		"crons": ["0 8 * * 1"]
	}
}
