<Project Sdk="Microsoft.NET.Sdk">
  <!-- Maintainer tool: writes ref/*.cs, compile-only stubs of the Flare API members the plugin uses, so CI can build
       without MadCap's DLLs. Run after a Flare upgrade or when the plugin starts using new API members. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
  </ItemGroup>
</Project>
