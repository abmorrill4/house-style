<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>FlareAI.Flare</RootNamespace>
    <AssemblyName>FlareAI.Flare</AssemblyName>
    <!-- Flare 22 ships B3.PluginAPIKit built for .NET 4.8, so the plugin must target net48. The ribbon API is WPF; dialogs are WinForms. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />            <!-- updates: ZipExtractor -->
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- WPF, needed for RibbonControlData / ICommand / BitmapImage used by the Flare ribbon API -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\lib\B3.PluginAPIKit.dll')">
    <!-- Copied from the Flare install by scripts\bootstrap.ps1. Never redistributed. -->
    <Reference Include="B3.PluginAPIKit">
      <HintPath>..\..\lib\B3.PluginAPIKit.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Flare internals for the docked sidebar only (UI/PanelHost.cs, FlarePane). Not public API: every use is
         behind a try/catch fallback. Copied from the Flare install by the bootstrap script; never shipped. -->
    <Reference Include="B3.AppKit"><HintPath>..\..\lib\B3.AppKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="B3.CoreKit"><HintPath>..\..\lib\B3.CoreKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="B3.CommonInterfacesKit"><HintPath>..\..\lib\B3.CommonInterfacesKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="B3.CssKit"><HintPath>..\..\lib\B3.CssKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="B3.XmlKit"><HintPath>..\..\lib\B3.XmlKit.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- No Flare on this machine (CI, contributors): build against ref\, open-source declarations of just the API members
       the plugin uses (generated by tools\FlareAI.RefStubs). Flare's B3 DLLs aren't strong-named, so Flare's own load at runtime. -->
  <ItemGroup Condition="!Exists('..\..\lib\B3.PluginAPIKit.dll')">
    <ProjectReference Include="..\..\ref\B3.PluginAPIKit\B3.PluginAPIKit.csproj" Private="false" />
    <ProjectReference Include="..\..\ref\B3.AppKit\B3.AppKit.csproj" Private="false" />
    <ProjectReference Include="..\..\ref\B3.CoreKit\B3.CoreKit.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlareAI.Core\FlareAI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The local debug log (Logging\SerilogLog.cs). Core never references these; it writes to its own ILog. -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release notes for the What's new window; ships at the plugin root. -->
    <None Include="whats-new.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The practice project for the guided first lint; ships at Samples\HouseStylePractice in the plugin folder. -->
    <None Update="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
