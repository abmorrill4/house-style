<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tests run on a modern framework; Core (net40) is binary-compatible. -->
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>FlareAI.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlareAI.Core\FlareAI.Core.csproj" />
    <ProjectReference Include="..\FlareAI.TestKit\FlareAI.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The command table has no Flare dependencies, so the tests can check it directly. -->
    <Compile Include="..\..\src\FlareAI.Flare\Commands.cs" Link="Commands.cs" />
    <!-- The update unzipper (net48 only, so it lives in the plugin); no Flare dependencies. -->
    <Compile Include="..\..\src\FlareAI.Flare\ZipExtractor.cs" Link="ZipExtractor.cs" />
    <!-- The report zip (the fallback when the feedback service can't be reached); no Flare dependencies. -->
    <Compile Include="..\..\src\FlareAI.Flare\ReportZip.cs" Link="ReportZip.cs" />
    <!-- The dialog layout (WinForms only, no Flare dependencies): status lines fit their text, hidden blocks leave no gap. -->
    <Compile Include="..\..\src\FlareAI.Flare\UI\StackLayout.cs" Link="StackLayout.cs" />
    <Compile Include="..\..\src\FlareAI.Flare\UI\A11y.cs" Link="A11y.cs" />
    <!-- The review pane's row, button and label sizing (pure functions): readable at Flare's narrow default width. -->
    <Compile Include="..\..\src\FlareAI.Flare\UI\PaneRows.cs" Link="PaneRows.cs" />
  </ItemGroup>

</Project>
